<UserControl x:Class="FastGithub.UI.FlowChart"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid>
            <TextBlock Text="实时流量" Style="{DynamicResource Heading}"/>
            <TextBlock x:Name="UpdateTime" Text="最近 60 秒" Foreground="{DynamicResource MutedBrush}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>
        <Grid Grid.Row="1" Margin="0,23,0,19">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="下行速率" Style="{DynamicResource SecondaryText}"/>
                <TextBlock x:Name="WriteRate" Text="—" FontFamily="Consolas" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,5,0,5"/>
                <TextBlock x:Name="textBlockWrite" Text="累计接收 —" Style="{DynamicResource SecondaryText}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="24,0,0,0">
                <TextBlock Text="上行速率" Style="{DynamicResource SecondaryText}"/>
                <TextBlock x:Name="ReadRate" Text="—" FontFamily="Consolas" FontSize="26" FontWeight="SemiBold" Margin="0,5,0,5"/>
                <TextBlock x:Name="textBlockRead" Text="累计发送 —" Style="{DynamicResource SecondaryText}"/>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="2">
            <lvc:CartesianChart x:Name="flowChart" Visibility="Collapsed" Series="{Binding Series}" LegendLocation="None" DisableAnimations="True" Hoverable="False" DataTooltip="{x:Null}" Margin="-8,0,0,0">
                <lvc:CartesianChart.AxisX>
                    <lvc:Axis Foreground="#5D6B80" FontSize="11" LabelFormatter="{Binding XFormatter}" DisableAnimations="True">
                        <lvc:Axis.Separator><lvc:Separator Stroke="#EEF1F6" Step="15000"/></lvc:Axis.Separator>
                    </lvc:Axis>
                </lvc:CartesianChart.AxisX>
                <lvc:CartesianChart.AxisY>
                    <lvc:Axis Foreground="#5D6B80" FontSize="11" MinValue="0" LabelFormatter="{Binding YFormatter}" DisableAnimations="True">
                        <lvc:Axis.Separator><lvc:Separator Stroke="#E7ECF3"/></lvc:Axis.Separator>
                    </lvc:Axis>
                </lvc:CartesianChart.AxisY>
            </lvc:CartesianChart>
            <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
                <TextBlock Text="尚无流量数据" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <TextBlock Text="启动服务后，这里会显示最近 60 秒的速率" Style="{DynamicResource SecondaryText}" TextAlignment="Center" Margin="0,9,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
