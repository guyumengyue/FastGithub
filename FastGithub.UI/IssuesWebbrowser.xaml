<UserControl x:Class="FastGithub.UI.IssuesWebbrowser"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,16,0">
            <TextBlock Text="先选择适合的连接模式" Style="{DynamicResource Heading}"/>
            <TextBlock Text="透明模式会接管配置域名的流量。若影响了 IIS、localhost 或其他代理，请先停止服务，在「连接设置」中切换到显式代理，再为浏览器或 Git 设置本地代理。" Style="{DynamicResource SecondaryText}" LineHeight="23" Margin="0,10,0,24"/>
            <TextBlock Text="处理证书验证失败" Style="{DynamicResource Heading}"/>
            <TextBlock Text="首次运行会在 cacert 文件夹生成当前电脑的 CA。浏览器或 Git 使用独立证书库时，需要导入或指定这个证书；不要关闭证书验证，也不要共享 .key 私钥文件。" Style="{DynamicResource SecondaryText}" LineHeight="23" Margin="0,10,0,12"/>
            <TextBlock Text="Firefox：设置 → 隐私与安全 → 证书 → 查看证书 → 证书颁发机构，导入 fastgithub.cer 并信任其标识网站。" Style="{DynamicResource SecondaryText}" LineHeight="23" Margin="0,0,0,24"/>
            <TextBlock Text="服务运行但 GitHub 仍然打不开" Style="{DynamicResource Heading}"/>
            <TextBlock Text="「服务运行中」表示本地核心已响应，不保证公网连接可用。打开「运行日志」，筛选警告及错误，再检查 DNS、上游 TLS 或连接重置的具体记录。" Style="{DynamicResource SecondaryText}" LineHeight="23" Margin="0,10,0,24"/>
            <TextBlock Text="从托盘管理服务" Style="{DynamicResource Heading}"/>
            <TextBlock Text="点击窗口关闭按钮会收起到托盘。单击托盘图标可重新打开窗口；托盘菜单可以启停服务或完全退出。退出时会等待核心正常停止。" Style="{DynamicResource SecondaryText}" LineHeight="23" Margin="0,10,0,22"/>
            <TextBlock><Hyperlink NavigateUri="https://github.com/creazyboyone/FastGithub/issues" RequestNavigate="OpenLink">查看项目问题与讨论</Hyperlink></TextBlock>
            <TextBlock x:Name="HelpFeedback" TextWrapping="Wrap" Foreground="#B43D35" Margin="0,10,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
