<UserControl x:Class="FastGithub.UI.UdpLogListBox"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="148"/></Grid.ColumnDefinitions>
            <Grid Margin="0,0,12,0">
                <TextBox x:Name="SearchBox" TextChanged="FilterChanged" AutomationProperties.Name="搜索日志"/>
                <TextBlock Text="搜索消息或来源" Foreground="{DynamicResource MutedBrush}" Margin="11,0" VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
            </Grid>
            <ComboBox x:Name="LevelFilter" Grid.Column="1" SelectedIndex="0" SelectionChanged="FilterChanged" VerticalContentAlignment="Center" Padding="8" AutomationProperties.Name="日志级别">
                <ComboBoxItem Content="全部级别"/><ComboBoxItem Content="警告及错误"/><ComboBoxItem Content="仅错误"/>
            </ComboBox>
        </Grid>
        <DockPanel Grid.Row="1" Margin="0,0,0,10">
            <CheckBox x:Name="PauseScroll" Content="暂停自动滚动" VerticalAlignment="Center" FontSize="12"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CopyButton" Content="复制选中项" IsEnabled="False" Click="MenuItem_Copy_Click" Padding="10,5" MinHeight="30"/>
                <Button Content="导出日志" Click="ExportLogs" Padding="10,5" MinHeight="30" Margin="8,0,0,0"/>
                <Button Content="清空" Click="MenuItem_Clear_Click" Padding="10,5" MinHeight="30" Margin="8,0,0,0"/>
            </StackPanel>
        </DockPanel>
        <Grid Grid.Row="2">
            <ListBox x:Name="listBox" ItemsSource="{Binding LogList}" Background="Transparent" BorderThickness="0"
                VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                SelectionChanged="SelectionChanged" HorizontalContentAlignment="Stretch">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="10,12"/><Setter Property="Margin" Value="0,0,0,1"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusOutline}"/>
                        <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/><Setter Property="Foreground" Value="{DynamicResource InkBrush}"/></Trigger></Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Text="{Binding LevelName}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding Color}" Margin="0,0,12,0"/>
                                <TextBlock Text="{Binding Timestamp, StringFormat={}{0:HH:mm:ss.fff}}" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
                                <TextBlock Text="{Binding SourceContext}" TextTrimming="CharacterEllipsis" FontSize="11" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Right" Margin="14,0,0,0"/>
                            </DockPanel>
                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="13" LineHeight="21"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel x:Name="EmptyLogs" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                <TextBlock x:Name="EmptyTitle" Text="等待运行日志" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <TextBlock x:Name="EmptyHint" Text="启动服务后，连接和诊断记录会显示在这里。" Style="{DynamicResource SecondaryText}" Margin="0,9,0,0" TextAlignment="Center"/>
            </StackPanel>
        </Grid>
        <TextBlock x:Name="LogFeedback" Grid.Row="3" Text="0 条记录 · 最多保留 500 条" Style="{DynamicResource SecondaryText}" FontSize="11" Margin="0,8,0,0"/>
    </Grid>
</UserControl>
